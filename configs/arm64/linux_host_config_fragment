CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Live Update / KHO Support
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_KEXEC_HANDOVER=y
CONFIG_KEXEC_HANDOVER_ENABLE_DEFAULT=y
CONFIG_KEXEC_HANDOVER_DEBUG=y
CONFIG_LIVEUPDATE=y
CONFIG_LIVEUPDATE_MEMFD=y
CONFIG_LIVEUPDATE_GUEST_MEMFD=y
CONFIG_RELOCATABLE=y
CONFIG_HOTPLUG_CPU=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y

# Host Virtualization capabilities
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_CARETAKER=y
CONFIG_KVM_CARETAKER_DEBUG=y
CONFIG_VHOST_NET=y
CONFIG_VHOST=y
CONFIG_VHOST_VSOCK=y

# IOMMU & VFIO
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_V3=y
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_VFIO_IOMMU_TYPE1=y

# PCI & Virtio (for running as guest itself)
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SCSI_VIRTIO=y

# Core System
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HVC_DRIVER=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_BINFMT_MISC=y

# Memory architecture (ARMv9.0-A requires 48-bit VA)
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set

# Networking (Host needs bridge/tun for VMs)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_MACVLAN=y
CONFIG_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_HUGETLBFS=y

# /dev/mem physical access (required for ovm_monitor & live update telemetry)
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_IO_STRICT_DEVMEM is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_WLAN is not set
# CONFIG_USB is not set
# CONFIG_DRM is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_WERROR is not set
CONFIG_ARM_GIC_V3=y

# Baremetal Platform Drivers & Disk Encryption (BondiBeach / Axion)
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PCA954x=y
CONFIG_I2C_MUX_PCA9541=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_EEPROM_AT24=y
CONFIG_EEPROM_AT25=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SYSFS=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_DM_BUILTIN=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_IDPF=y
CONFIG_LAN743X=y
