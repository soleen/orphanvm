BR2_TARGET_GENERIC_GETTY_OPTIONS="-n -l /bin/autologin"
BR2_ROOTFS_OVERLAY="../overlays/buildroot_host"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_LZ4=y
BR2_x86_64=y

# Init system
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_ANALYZE=y

# Analysis and debugging tools
BR2_PACKAGE_LINUX_TOOLS_PERF=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_SYSSTAT=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_COREUTILS=y

# QEMU Virtualizer
BR2_PACKAGE_QEMU=y
BR2_PACKAGE_QEMU_SYSTEM=y
BR2_PACKAGE_QEMU_CHOOSE_TARGETS=y
BR2_PACKAGE_QEMU_TARGET_X86_64=y

# SSH Server for remote access
BR2_PACKAGE_DROPBEAR=y

# Kexec tools
BR2_PACKAGE_KEXEC=y
BR2_PACKAGE_KEXEC_ZLIB=y

# Ext4 filesystem image for Virtio block rootfs
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"





